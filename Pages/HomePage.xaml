<Page
    x:Class="LumiaYT.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="12,8,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="LUMIA" Style="{StaticResource AppTitleTextStyle}" />
                <TextBlock Text="  YT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" Click="Refresh_Click" ToolTipService.ToolTip="Atualizar" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" Click="Settings_Click" ToolTipService.ToolTip="Configurações" />
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Margin="12,6,12,6" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" PlaceholderText="Buscar no YouTube..." KeyDown="SearchBox_KeyDown" />
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE721;" Height="36" Width="40" Click="Search_Click" />
            </Grid>
        </Border>

        <!-- Tabs/filters -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,8">
            <Button x:Name="TrendingTab" Content="Trending" Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" Click="Trending_Click" />
            <Button x:Name="SubsTab" Content="Inscrições" Style="{StaticResource FilterButtonStyle}" Click="Subs_Click" />
        </StackPanel>

        <!-- Results -->
        <Grid Grid.Row="3">
            <ListView x:Name="VideoList" IsItemClickEnabled="True" ItemClick="VideoList_ItemClick" SelectionMode="None" Padding="8,0,8,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,0,4,8" Background="{ThemeResource SurfaceBrush}" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="79" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3,0,0,3">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,8,10,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding PublishedAt}" Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="12,4,12,8" />
    </Grid>
</Page>
