<Page
    x:Class="LumiaYT.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="12,8,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="LUMIA" Style="{StaticResource AppTitleTextStyle}" />
                <TextBlock Text="  YT" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" Click="Refresh_Click" ToolTipService.ToolTip="Atualizar" />
                <Button x:Name="UserButton" Style="{StaticResource IconButtonStyle}" Click="Settings_Click" ToolTipService.ToolTip="Você">
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="14" Background="{ThemeResource SurfaceAltBrush}" />
                        <FontIcon x:Name="UserButtonIcon" Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="UserButtonAvatar" Stretch="UniformToFill" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search with suggestions -->
        <Border Grid.Row="1" Margin="12,6,12,6" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Buscar no YouTube..."
                                TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                SuggestionChosen="SearchBox_SuggestionChosen"
                                UpdateTextOnSelect="True"
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="4,0,0,0" />
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE721;" Height="36" Width="40" Click="Search_Click" />
            </Grid>
        </Border>

        <!-- Tabs -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="12,0,12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RecommendedTab" Content="Recomendados" Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" Click="Recommended_Click" />
                <Button x:Name="TrendingTab" Content="Em alta" Style="{StaticResource FilterButtonStyle}" Margin="0,0,6,0" Click="Trending_Click" />
                <Button x:Name="SubsTab" Content="Inscrições" Style="{StaticResource FilterButtonStyle}" Click="Subs_Click" />
            </StackPanel>
        </ScrollViewer>

        <!-- Content -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Subscription channels carousel -->
            <ListView x:Name="SubsChannelsList" Grid.Row="0" Visibility="Collapsed" Height="86" Margin="8,0,8,6"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollMode="Disabled" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="SubsChannelsList_ItemClick">
                <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="72" Margin="4,0,4,0">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource SurfaceAltBrush}" HorizontalAlignment="Center">
                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource MetaTextStyle}" TextAlignment="Center" MaxLines="1" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="VideoList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="VideoList_ItemClick" SelectionMode="None" Padding="8,0,8,0"
                      Loaded="VideoList_Loaded">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,0,4,8" Background="{ThemeResource SurfaceBrush}" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="79" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3,0,0,3">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,8,10,8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding PublishedAt}" Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel Margin="0,4,0,12">
                        <ProgressRing x:Name="MoreLoadingRing" IsActive="False" Width="28" Height="28" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </ListView.Footer>
            </ListView>

            <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                <TextBlock x:Name="EmptyStateText" Style="{StaticResource BodyTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="False" Width="40" Height="40" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="12,4,12,8" />
    </Grid>
</Page>
