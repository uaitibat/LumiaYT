<Page
    x:Class="LumiaYT.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBrush}">
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="LumiaYT" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="YouTube estilo Metro" FontSize="12" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Config" Click="Settings_Click" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Buscar no YouTube..." />
            <Button Grid.Column="1" Content="Buscar" Click="Search_Click" Margin="8,0,0,0" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Trending" Click="Trending_Click" Margin="0,0,8,0" />
            <Button Content="Inscrições" Click="Subs_Click" />
        </StackPanel>

        <ListView x:Name="VideoList" Grid.Row="3" IsItemClickEnabled="True" ItemClick="VideoList_ItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="6" Margin="0,2" Background="{StaticResource CardBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Width="112" Height="63" Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" MaxLines="2" />
                            <TextBlock Text="{Binding ChannelTitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding PublishedAt}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</Page>
