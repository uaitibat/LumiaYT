<Page
    x:Class="LumiaYT.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;" Click="Back_Click" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource PageHeaderTextStyle}" VerticalAlignment="Center" Margin="4,0,0,0" MaxLines="2" TextTrimming="CharacterEllipsis" />
        </Grid>

        <MediaPlayerElement x:Name="Player" Grid.Row="1" Height="240" AreTransportControlsEnabled="True" Background="{ThemeResource SurfaceAltBrush}" />

        <ScrollViewer Grid.Row="2" Padding="12,10,12,16">
            <StackPanel>
                <TextBlock x:Name="ChannelText" Style="{StaticResource SubheaderTextStyle}" Foreground="{ThemeResource AccentTextBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ComboBox x:Name="QualityCombo" Width="170" DisplayMemberPath="DisplayLabel" SelectionChanged="QualityCombo_SelectionChanged" IsEnabled="False" />
                    <Button Content="Abrir no navegador" Style="{StaticResource MetroButtonStyle}" Click="OpenBrowser_Click" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="DescText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3" Padding="10" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
