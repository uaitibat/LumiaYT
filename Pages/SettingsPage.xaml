<Page
    x:Class="LumiaYT.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBrush}">

    <ScrollViewer>
        <StackPanel Padding="12,8,12,24">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;" Click="Back_Click" />
                <TextBlock Grid.Column="1" Text="Você" Style="{StaticResource AppTitleTextStyle}" FontSize="20" Margin="4,0,0,0" />
            </Grid>

            <!-- Logged-out / setup -->
            <StackPanel x:Name="LoggedOutPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ENTRAR" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Faça login para ver inscrições, curtidos e recomendações da sua conta." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button x:Name="LoginCodeButton" Content="Entrar com código" Style="{StaticResource MetroButtonStyle}" Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource TextOnAccentBrush}" Click="DeviceCodeLogin_Click" />

                        <Border x:Name="DeviceCodePanel" Visibility="Collapsed" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Abra no PC/outro navegador:" Style="{StaticResource MetaTextStyle}" />
                                <TextBlock x:Name="DeviceUrlText" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Margin="0,2,0,8" />
                                <TextBlock Text="Código:" Style="{StaticResource MetaTextStyle}" />
                                <TextBlock x:Name="DeviceCodeText" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" IsTextSelectionEnabled="True" Margin="0,2,0,8" />
                                <TextBlock x:Name="DeviceStatusText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="CONFIGURAÇÃO DA API" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="API Key (v3)" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ApiKeyBox" PlaceholderText="AIza..." Margin="0,0,0,10" />
                        <TextBlock Text="Client ID" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ClientIdBox" PlaceholderText="....apps.googleusercontent.com" Margin="0,0,0,10" />
                        <TextBlock Text="Client Secret (se houver)" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ClientSecretBox" PlaceholderText="Client secret" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Importar arquivo..." Style="{StaticResource MetroButtonStyle}" Click="ImportFile_Click" Margin="0,0,8,0" />
                            <Button Content="Salvar" Style="{StaticResource MetroButtonStyle}" Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource TextOnAccentBrush}" Click="Save_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Logged-in profile -->
            <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SurfaceAltBrush}">
                            <Grid>
                                <FontIcon x:Name="UserIcon" Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="UserAvatar" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="Conta Google" Style="{StaticResource PageHeaderTextStyle}" />
                            <TextBlock x:Name="UserEmailText" Text="" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Sair" Style="{StaticResource MetroButtonStyle}" VerticalAlignment="Center" Click="Logout_Click" />
                    </Grid>
                </Border>

                <!-- Library sections -->
                <TextBlock Text="Histórico" Style="{StaticResource SubheaderTextStyle}" Margin="12,8,12,6" />
                <ListView x:Name="HistoryList" Height="170" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" IsItemClickEnabled="True" ItemClick="Video_ItemClick" SelectionMode="None">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="0,0,8,0" Background="{ThemeResource SurfaceBrush}" CornerRadius="3">
                                <StackPanel>
                                    <Border Height="84" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3,3,0,0"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" Margin="8,6,8,0" MaxLines="2" />
                                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MetaTextStyle}" Margin="8,2,8,8" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Playlists" Style="{StaticResource SubheaderTextStyle}" Margin="12,8,12,6" />
                <ListView x:Name="PlaylistsList" Height="170" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" IsItemClickEnabled="True" ItemClick="Playlist_ItemClick" SelectionMode="None">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="0,0,8,0" Background="{ThemeResource SurfaceBrush}" CornerRadius="3">
                                <StackPanel>
                                    <Border Height="84" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3,3,0,0"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" Margin="8,6,8,0" MaxLines="2" />
                                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MetaTextStyle}" Margin="8,2,8,8" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="PlaylistsHint" Text="" Style="{StaticResource MetaTextStyle}" Margin="12,0,12,6" />

                <TextBlock Text="Assistir mais tarde" Style="{StaticResource SubheaderTextStyle}" Margin="12,8,12,6" />
                <ListView x:Name="WatchLaterList" Height="170" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" IsItemClickEnabled="True" ItemClick="Video_ItemClick" SelectionMode="None">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="0,0,8,0" Background="{ThemeResource SurfaceBrush}" CornerRadius="3">
                                <StackPanel>
                                    <Border Height="84" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3,3,0,0"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" Margin="8,6,8,0" MaxLines="2" />
                                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MetaTextStyle}" Margin="8,2,8,8" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Vídeos curtidos" Style="{StaticResource SubheaderTextStyle}" Margin="12,8,12,6" />
                <ListView x:Name="LikedList" Height="170" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" IsItemClickEnabled="True" ItemClick="Video_ItemClick" SelectionMode="None">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Width="150" Margin="0,0,8,0" Background="{ThemeResource SurfaceBrush}" CornerRadius="3">
                                <StackPanel>
                                    <Border Height="84" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3,3,0,0"><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/></Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleTextStyle}" Margin="8,6,8,0" MaxLines="2" />
                                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource MetaTextStyle}" Margin="8,2,8,8" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Clipes" Style="{StaticResource SubheaderTextStyle}" Margin="12,8,12,6" />
                <TextBlock x:Name="ClipsHint" Text="Clipes não estão disponíveis via API oficial neste app." Style="{StaticResource MetaTextStyle}" Margin="12,0,12,6" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="12,8,12,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
