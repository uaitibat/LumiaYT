<Page
    x:Class="LumiaYT.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PageBrush}">

    <ScrollViewer>
        <StackPanel Padding="12,8,12,24">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;" Click="Back_Click" />
                <TextBlock Grid.Column="1" Text="Você" Style="{StaticResource AppTitleTextStyle}" FontSize="20" Margin="4,0,0,0" />
            </Grid>

            <!-- Conta / perfil -->
            <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SurfaceAltBrush}">
                            <Grid>
                                <FontIcon x:Name="UserIcon" Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="UserAvatar" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText" Text="Não conectado" Style="{StaticResource PageHeaderTextStyle}" />
                            <TextBlock x:Name="UserEmailText" Text="Faça login para ver suas inscrições e recomendações" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AuthStatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LoginCodeButton" Content="Entrar com código" Style="{StaticResource MetroButtonStyle}" Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource TextOnAccentBrush}" Click="DeviceCodeLogin_Click" Margin="0,0,8,0" />
                        <Button x:Name="LogoutButton" Content="Sair" Style="{StaticResource MetroButtonStyle}" Click="Logout_Click" Visibility="Collapsed" />
                    </StackPanel>

                    <Border x:Name="DeviceCodePanel" Visibility="Collapsed" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="3" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Abra no PC/outro navegador:" Style="{StaticResource MetaTextStyle}" />
                            <TextBlock x:Name="DeviceUrlText" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource TextPrimaryBrush}" IsTextSelectionEnabled="True" Margin="0,2,0,8" />
                            <TextBlock Text="Código:" Style="{StaticResource MetaTextStyle}" />
                            <TextBlock x:Name="DeviceCodeText" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextBrush}" IsTextSelectionEnabled="True" Margin="0,2,0,8" />
                            <TextBlock x:Name="DeviceStatusText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Advanced / dev -->
            <Button x:Name="AdvancedToggle" Content="Mostrar opções avançadas" Style="{StaticResource MetroButtonStyle}" HorizontalAlignment="Stretch" Click="AdvancedToggle_Click" Margin="0,0,0,8" />

            <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="YOUTUBE DATA API" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="API Key (v3)" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ApiKeyBox" PlaceholderText="AIza..." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="OAUTH" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Client ID" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ClientIdBox" PlaceholderText="....apps.googleusercontent.com" Margin="0,0,0,10" />
                        <TextBlock Text="Client Secret (opcional no device code)" Style="{StaticResource MetaTextStyle}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="ClientSecretBox" PlaceholderText="Client secret" Margin="0,0,0,10" />
                        <TextBlock x:Name="RedirectUriText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="IMPORTAR CONFIG" Style="{StaticResource SubheaderTextStyle}" Margin="0,0,0,8" />
                        <Button Content="Importar arquivo..." Style="{StaticResource MetroButtonStyle}" Click="ImportFile_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Salvar" Style="{StaticResource MetroButtonStyle}" Background="{ThemeResource AccentBrush}" Foreground="{ThemeResource TextOnAccentBrush}" Click="Save_Click" Margin="0,0,8,0" />
                            <Button Content="Login (WebView)" Style="{StaticResource MetroButtonStyle}" Click="WebViewLogin_Click" Margin="0,0,8,0" />
                            <Button Content="Login WAB" Style="{StaticResource MetroButtonStyle}" Click="Login_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource MetaTextStyle}" TextWrapping="Wrap" Margin="12,0,12,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
