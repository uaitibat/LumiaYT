<Page
    x:Class="LumiaYT.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PageBrush}">
    <ScrollViewer Padding="12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Voltar" Click="Back_Click" Margin="0,0,8,0" />
                <TextBlock Text="Configurações" FontSize="26" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="YouTube Data API v3 Key" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="ApiKeyBox" PlaceholderText="AIza..." Margin="0,4,0,12" />

            <TextBlock Text="Google OAuth Client ID" Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="ClientIdBox" PlaceholderText="....apps.googleusercontent.com" Margin="0,4,0,12" />

            <TextBlock Text="Google OAuth Client Secret" Foreground="{StaticResource TextMutedBrush}" />
            <PasswordBox x:Name="ClientSecretBox" PlaceholderText="Client secret" Margin="0,4,0,12" />

            <TextBlock x:Name="RedirectUriText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Salvar" Click="Save_Click" Margin="0,0,8,0" />
                <Button Content="Login Google" Click="Login_Click" Margin="0,0,8,0" />
                <Button Content="Logout" Click="Logout_Click" />
            </StackPanel>

            <TextBlock x:Name="AuthStatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
